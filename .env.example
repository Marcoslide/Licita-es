# Caminho local. Em produção, monte um volume persistente ou adapte a camada DB para PostgreSQL.
BOLSA_DATABASE_PATH=data/bolsa_licitacoes.db
BOLSA_DOCUMENTS_PATH=data/documents
BOLSA_HTTP_TIMEOUT=30
BOLSA_HTTP_RETRIES=3
BOLSA_HTTP_USER_AGENT=BolsaDeLicitacoes/0.1 (+contato-do-operador)

# Obrigatório apenas para o conector do Portal da Transparência (ainda pendente de credencial).
PORTAL_TRANSPARENCIA_API_TOKEN=
